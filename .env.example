# Required: WebUI login key (not a ChatGPT account).
# First `pnpm start:dev` / `pnpm ensure:env` replaces the placeholder with a
# random secret and prints it once. Copy that value to log in.

# Optional: backend listen port (default 8172)
PORT=8172

# Optional: OpenAI API key (only if you use API-key auth instead of ChatGPT login)
OPENAI_API_KEY=

# Optional: Pino log level (default: info)
# LOG_LEVEL=info

# Optional: path to codex CLI binary (default: codex on PATH)
# After `pnpm install`, Windows can point at the bundled binary, e.g.:
# CODEX_BIN=./node_modules/@openai/codex-win32-x64/vendor/x86_64-pc-windows-msvc/bin/codex.exe
# CODEX_BIN=codex

# Optional: codex home directory (default: ~/.codex)
# CODEX_HOME=

# Optional: SQLite database path (default: CODEX_HOME/codex-webui.sqlite)
# WEBUI_DB_PATH=

# Optional: research project managed root (default: ~/.codex/research-projects)
# NAVIVISOR_RESEARCH_WORK_ROOT=

# Runtime settings such as workspace roots, upload limits, and terminal
# defaults/limits are stored in SQLite and can be changed from Settings.
# Their legacy env vars still work as fallback overrides when no DB value is set.

# --- Frontend (web/) ---
# Dev server needs no .env by default: Vite proxies /api and /socket.io to :8172.
# Optional only if you point the submission module at a remote mock API:
# VITE_SUBMISSION_API_BASE_URL=
